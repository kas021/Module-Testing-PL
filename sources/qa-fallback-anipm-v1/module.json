  "moduleStatus": "trial",
  "description": "TEST-only failure-injection module. AniPM search, details and episode catalogues are retained for automatic fallback mapping tests. Stream resolution always fails locally with a descriptive QA error and sends no stream request.",
  "presentation": {
    "category": "Testing",
    "purpose": "Testing only - deterministic fallback failure",
    "recommended": false,
    "language": "English Sub/Dub",
    "languages": [
      "sub",
      "dub"
    ],
    "iconUrl": "https://ani.pm/apple-touch-icon.png"
  },
  "config": {
    "language": "English",
    "contentLanguage": "en",
    "baseUrl": "https://ani.pm",
    "capabilities": {
      "discovery_v1": true
    },
    "runtime": {
      "entry": "index.js",
      "mode": "local"
    },
    "caps": {
      "homeMaxResults": 30,
      "maxResponseBytes": 2500000,
      "timeoutMs": 25000,
      "maxConcurrentRequests": 4
    },
    "streamHeaders": {
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/137.0.0.0 Safari/537.36"
    },
