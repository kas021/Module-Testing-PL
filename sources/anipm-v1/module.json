{
  "id": "anipm-v1",
  "name": "AniPM",
  "contentType": "video",
  "contractVersion": 4,
  "moduleVersion": "0.1.0-beta.5",
  "moduleFamilyId": "anipm-v1",
  "moduleIdentity": "SP-VID-084-ANIPM",
  "moduleIdentityNumber": 84,
  "releaseTrack": "beta",
  "moduleStatus": "active",
  "description": "English anime via ani.pm's own API and Settlar playback service. Full catalogue search, endless paginated browse, sub/dub episodes, adaptive quality master playlists, English captions, opening/ending skip markers. No third-party scraping - catalogue and playback both come from ani.pm.",
  "presentation": {
    "category": "Anime",
    "purpose": "English Anime (AniPM)",
    "recommended": false,
    "language": "English Sub/Dub",
    "languages": [
      "sub",
      "dub"
    ],
    "iconUrl": "https://ani.pm/apple-touch-icon.png"
  },
  "config": {
    "language": "English",
    "contentLanguage": "en",
    "baseUrl": "https://ani.pm",
    "capabilities": {
      "discovery_v1": true
    },
    "runtime": {
      "entry": "index.js",
      "mode": "local"
    },
    "caps": {
      "homeMaxResults": 30,
      "maxResponseBytes": 2500000,
      "timeoutMs": 25000,
      "maxConcurrentRequests": 4
    },
    "streamHeaders": {
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/137.0.0.0 Safari/537.36"
    },
    "catalogueMapping": {
      "version": 2,
      "routes": [
        {
          "namespace": "anipm:anime",
          "seriesId": "anipm:{id}",
          "episodeId": "anipm:{id}:e{episode}",
          "numbering": "absolute"
        },
        {
          "namespace": "qa:anipm-catalogue-v1",
          "seriesId": "anipm:{id}",
          "episodeId": "anipm:{id}:e{episode}",
          "numbering": "absolute"
        }
      ]
    },
    "sourceFallbacks": {
      "version": 1,
      "groups": [
        {
          "publisher": "manual:anipm-v1",
          "source": "anipm-v1",
          "group": "ani-pm-anime-catalogue",
          "revision": 1,
          "name": "AniKoto and AniPM",
          "contentType": "video",
          "primary": {
            "publisher": "manual:anipm-v1",
            "source": "anipm-v1",
            "moduleId": "anipm-v1",
            "name": "AniPM"
          },
          "alternatives": [
            {
              "publisher": "manual:anikoto-v4",
              "source": "anikoto-v3",
              "moduleId": "anikoto-v4",
              "name": "AniKoto"
            }
          ]
        }
      ]
    }
  },
  "version": "0.1.0-beta.5"
}
